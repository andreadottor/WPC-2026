@page "/demo/web-worker"
@rendermode InteractiveWebAssembly
@using System.Diagnostics
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Demo 5 · Web Worker</PageTitle>

<DemoHeader Number="5" Title="Lavoro pesante in un Web Worker con il template blazorwebworker">
    In WebAssembly il codice .NET gira sul thread della UI: un calcolo lungo blocca la pagina.
    Il nuovo template <code>blazorwebworker</code> genera il client e gli script per eseguire metodi
    <code>[JSExport]</code> in un Web Worker, con la UI che resta reattiva.
</DemoHeader>

<div class="card mb-4">
    <div class="card-header fw-semibold">La pagina è reattiva?</div>
    <div class="card-body">
        <div class="ww-track mb-3" aria-hidden="true"><div class="ww-ball"></div></div>
        <div class="d-flex flex-wrap align-items-center gap-4">
            <div>Orologio aggiornato da .NET: <strong class="font-monospace fs-5" data-testid="clock">@clock.ToString("HH:mm:ss.f")</strong></div>
            <input class="form-control w-auto" placeholder="Prova a scrivere qui durante il calcolo..." />
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold">Analisi di un CSV di ticket</div>
            <div class="card-body">
                <label class="form-label" for="rows">Righe da generare</label>
                <select id="rows" class="form-select mb-3" @bind="rows" disabled="@busy">
                    <option value="100000">100.000</option>
                    <option value="250000">250.000</option>
                    <option value="500000">500.000</option>
                </select>

                <div class="d-grid gap-2">
                    <button class="btn btn-outline-danger" @onclick="AnalyzeOnUiThread" disabled="@busy">
                        Analizza sul thread della UI
                    </button>
                    <button class="btn btn-primary" @onclick="AnalyzeInWorker" disabled="@(busy || worker is null)">
                        Analizza nel Web Worker
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="Cancel" disabled="@(cts is null)">
                        Annulla l'attesa del worker
                    </button>
                </div>

                <dl class="row small mt-3 mb-0 diagnostics">
                    <dt class="col-6">Web Worker</dt>
                    <dd class="col-6" data-testid="worker-status">@workerStatus</dd>
                    <dt class="col-6">Dati</dt>
                    <dd class="col-6">@(csv is null ? "non ancora generati" : $"{rows:N0} righe · {csv.Length / 1024.0 / 1024.0:N1} MB")</dd>
                    <dt class="col-6">Stato</dt>
                    <dd class="col-6" data-testid="status">@status</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                Risultato
                @if (lastRun is not null)
                {
                    <span class="badge @(lastRun.InWorker ? "text-bg-success" : "text-bg-danger") ms-2">@(lastRun.InWorker ? "Web Worker" : "Thread UI")</span>
                }
            </div>
            <div class="card-body">
                @if (lastRun is null)
                {
                    <p class="text-body-secondary mb-0">Avvia un'analisi per vedere il risultato.</p>
                }
                else
                {
                    <p class="small mb-2">
                        Calcolo: <strong>@lastRun.Summary.ElapsedMs.ToString("0") ms</strong> ·
                        totale (incluso il trasferimento dei dati): <strong>@lastRun.TotalMs.ToString("0") ms</strong> ·
                        righe analizzate: @lastRun.Summary.Rows.ToString("N0")
                    </p>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Categoria</th><th class="text-end">Ticket</th><th class="text-end">Media (h)</th><th class="text-end">P95 (h)</th><th class="text-end">Riaperti</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var category in lastRun.Summary.Categories)
                            {
                                <tr>
                                    <td>@category.Category</td>
                                    <td class="text-end">@category.Tickets.ToString("N0")</td>
                                    <td class="text-end">@category.AverageHours</td>
                                    <td class="text-end">@category.P95Hours</td>
                                    <td class="text-end">@category.Reopened.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<ObserveBox>
    <ol class="mb-2">
        <li>Premi <em>Analizza sul thread della UI</em>: la pallina e l'orologio si fermano e non puoi scrivere nel campo di testo finché il calcolo non termina.</li>
        <li>Premi <em>Analizza nel Web Worker</em>: stesso codice C#, stesso risultato, ma la pagina resta fluida.</li>
        <li>Il worker parte una volta sola (<code>WebWorkerClient.CreateAsync</code>) e carica il suo runtime .NET: guarda lo stato "pronto".</li>
    </ol>
    <p class="small text-body-secondary mb-0">
        <code>[JSExport]</code> accetta solo tipi semplici: il CSV entra come stringa e il risultato torna come JSON.
        Il <code>CancellationToken</code> interrompe l'attesa, non il calcolo già avviato nel worker.
        In una Blazor Web App il lavoro pesante di solito si fa sul server: il Web Worker serve quando il calcolo deve restare nel browser.
    </p>
</ObserveBox>

@code {
    private const string AnalyzeMethod = "Dottor.WPC2026.WebWorker.WorkerMethods.AnalyzeTickets";

    private WebWorkerClient? worker;
    private string workerStatus = "in attesa dell'interattività";
    private int rows = 250_000;
    private int generatedRows;
    private string? csv;
    private bool busy;
    private string status = "pronto";
    private RunResult? lastRun;
    private CancellationTokenSource? cts;
    private DateTime clock = DateTime.Now;
    private readonly CancellationTokenSource disposed = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _ = RunClockAsync();

        workerStatus = "avvio del runtime .NET nel worker...";
        StateHasChanged();
        var stopwatch = Stopwatch.StartNew();
        try
        {
            worker = await WebWorkerClient.CreateAsync(JS, cancellationToken: disposed.Token);
            workerStatus = $"pronto in {stopwatch.ElapsedMilliseconds} ms";
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            workerStatus = $"errore: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task RunClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(disposed.Token))
            {
                clock = DateTime.Now;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task AnalyzeOnUiThread()
    {
        await RunAsync(inWorker: false, data => Task.FromResult(TicketCsvAnalyzer.Analyze(data)));
    }

    private async Task AnalyzeInWorker()
    {
        cts = new CancellationTokenSource();
        try
        {
            await RunAsync(inWorker: true, async data =>
            {
                var json = await worker!.InvokeAsync<string>(AnalyzeMethod, [data], cancellationToken: cts.Token);
                return JsonSerializer.Deserialize(json, WorkerJsonContext.Default.CsvSummary)!;
            });
        }
        finally
        {
            cts.Dispose();
            cts = null;
        }
    }

    private async Task RunAsync(bool inWorker, Func<string, Task<CsvSummary>> analyze)
    {
        busy = true;
        if (csv is null || generatedRows != rows)
        {
            status = "generazione del CSV...";
            await Task.Delay(50); // lascia al browser il tempo di disegnare lo stato
            csv = TicketCsvAnalyzer.Generate(rows);
            generatedRows = rows;
        }

        status = inWorker ? "analisi nel Web Worker..." : "analisi sul thread della UI...";
        await Task.Delay(50);

        var stopwatch = Stopwatch.StartNew();
        try
        {
            var summary = await analyze(csv);
            lastRun = new RunResult(summary, stopwatch.Elapsed.TotalMilliseconds, inWorker);
            status = "completato";
        }
        catch (OperationCanceledException)
        {
            status = "attesa annullata (il worker termina comunque il calcolo in corso)";
        }
        catch (InvalidOperationException ex)
        {
            status = $"errore: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => cts?.Cancel();

    public async ValueTask DisposeAsync()
    {
        disposed.Cancel();
        if (worker is not null)
        {
            await worker.DisposeAsync();
        }
        disposed.Dispose();
    }

    private sealed record RunResult(CsvSummary Summary, double TotalMs, bool InWorker);
}

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Connessione interrotta. Riconnessione al server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Nuovo tentativo tra <span id="components-seconds-to-next-attempt"></span> secondi.
        </p>
        <p class="components-reconnect-failed-visible">
            Riconnessione non riuscita. Riprova senza ricaricare per conservare lo stato disponibile.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Riprova
        </button>
        <p class="components-server-pause-visible">
            Sessione sospesa dal server. Attendo la nuova istanza per riprendere automaticamente...
        </p>
        <p class="components-client-pause-visible">
            Sessione sospesa dal browser (scheda nascosta o <code>Blazor.pauseCircuit()</code>). Riprende quando la scheda torna visibile o premendo Riprendi.
        </p>
        <p class="components-resume-failed-visible">
            Ripresa non riuscita. Attendo il server; puoi anche riprovare manualmente.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Riprendi
        </button>
        <hr />
        <p id="resume-diagnostic" role="status"></p>
    </div>
</dialog>

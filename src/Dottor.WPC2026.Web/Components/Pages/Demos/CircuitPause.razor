@page "/demo/circuit-pause"
@rendermode InteractiveServer
@inject AppInstanceInfo Instance
@inject ShutdownCircuitHandler CircuitInfo
@inject CircuitShutdownService ShutdownService

<PageTitle>Demo 1 · Pausa e ripresa del circuito</PageTitle>

<DemoHeader Number="1" Title="Rilascio di una nuova versione senza perdere lo stato">
    Durante uno shutdown controllato il server chiede al browser di mettere in pausa il circuito.
    Lo stato marcato con <code>[PersistentState]</code> viaggia nel browser e torna al componente quando
    la nuova istanza riprende la sessione.
</DemoHeader>

@if (OriginalProcessId is int original && original != Instance.ProcessId)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="status">
        <span class="fs-4">✅</span>
        <div>
            <strong>Stato ripristinato!</strong>
            Il contatore e il ticket arrivano dal processo <code>@original</code> (@OriginalVersion);
            ora sei sul processo <code>@Instance.ProcessId</code> (@Instance.Version).
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Contatore <span class="badge text-bg-light border">[PersistentState]</span></div>
            <div class="card-body d-flex align-items-center gap-3">
                <span class="display-5" data-testid="counter">@Count</span>
                <button class="btn btn-primary" @onclick="() => Count++">Incrementa</button>
                <button class="btn btn-outline-secondary" @onclick="() => Count = 0">Azzera</button>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Ticket in compilazione <span class="badge text-bg-light border">[PersistentState]</span></div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="ticket-title" class="form-label">Titolo</label>
                    <input id="ticket-title" class="form-control" @bind="Ticket!.Title" @bind:event="oninput"
                           placeholder="Es. La stampante del 2° piano non risponde" />
                </div>
                <div class="mb-3">
                    <label for="ticket-description" class="form-label">Descrizione</label>
                    <textarea id="ticket-description" class="form-control" rows="4" @bind="Ticket!.Description" @bind:event="oninput"
                              placeholder="Scrivi qualcosa e poi lancia lo script di deploy..."></textarea>
                </div>
                <small class="text-body-secondary">
                    Il testo viene salvato nel componente a ogni tasto: nessun salvataggio esplicito.
                </small>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                Istanza del server
                <button class="btn btn-sm btn-outline-secondary" @onclick="StateHasChanged">Aggiorna</button>
            </div>
            <div class="card-body">
                <dl class="row mb-0 diagnostics">
                    <dt class="col-5">Versione</dt>
                    <dd class="col-7"><span class="badge text-bg-primary fs-6" data-testid="version">@Instance.Version</span></dd>
                    <dt class="col-5">Process ID</dt>
                    <dd class="col-7" data-testid="pid">@Instance.ProcessId</dd>
                    <dt class="col-5">Avviata alle</dt>
                    <dd class="col-7">@Instance.StartedAt.ToLocalTime().ToString("HH:mm:ss")</dd>
                    <dt class="col-5">Circuit Id</dt>
                    <dd class="col-7"><small>@(CircuitInfo.CircuitId ?? "— (prerendering)")</small></dd>
                    <dt class="col-5">Circuit connessi</dt>
                    <dd class="col-7">@ShutdownService.ConnectedCircuits</dd>
                    <dt class="col-5">Renderer</dt>
                    <dd class="col-7">@RendererInfo.Name (interattivo: @RendererInfo.IsInteractive)</dd>
                    <dt class="col-5">Stato creato da</dt>
                    <dd class="col-7">PID @OriginalProcessId · @OriginalVersion</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header fw-semibold">Simula il deploy</div>
            <div class="card-body">
                <p class="mb-2">Da un terminale nella root del repository:</p>
                <pre class="bg-body-tertiary p-2 rounded mb-2"><code>.\scripts\deploy-demo.ps1</code></pre>
                <small class="text-body-secondary">
                    Lo script chiama <code>POST /demo/shutdown</code>, attende la fine del processo e
                    riavvia l'app con <code>DEMO_VERSION</code> incrementata sulla stessa porta.
                </small>
            </div>
        </div>
    </div>
</div>

<ObserveBox>
    <ol class="mb-2">
        <li>Incrementa il contatore e scrivi qualcosa nel ticket (prova anche con una seconda scheda e valori diversi).</li>
        <li>Lancia <code>scripts\deploy-demo.ps1</code>: nei log compare <em>"Shutdown: richiesta di pausa per N circuit"</em>.</li>
        <li>Il browser mostra "La sessione è stata messa in pausa dal server" e attende <code>/health</code>.</li>
        <li>Al riavvio la sessione riprende da sola: contatore e testo sono identici, <strong>versione e PID sono cambiati</strong>.</li>
    </ol>
    <p class="small text-body-secondary mb-0">
        Limiti: viene persistito solo lo stato marcato con <code>[PersistentState]</code> (serializzabile in JSON, cifrato con Data Protection);
        i servizi scoped, i timer e le operazioni in corso no. Se lo shutdown supera il timeout o il processo viene terminato
        bruscamente, lo stato non raggiunge il browser. Su più server le chiavi di Data Protection devono essere condivise.
    </p>
</ObserveBox>

@code {
    [PersistentState]
    public int Count { get; set; }

    [PersistentState]
    public TicketDraft? Ticket { get; set; }

    // Memorizza quale processo ha creato lo stato: dopo il deploy è diverso da quello corrente.
    [PersistentState]
    public int? OriginalProcessId { get; set; }

    [PersistentState]
    public string? OriginalVersion { get; set; }

    protected override void OnInitialized()
    {
        Ticket ??= new TicketDraft();
        OriginalProcessId ??= Instance.ProcessId;
        OriginalVersion ??= Instance.Version;
    }
}

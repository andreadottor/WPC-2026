@page "/demo/circuit-pause"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@inject DemoInstance Instance
@inject ShutdownCircuitHandler Connection
@inject IOptions<AutoPauseDemoOptions> AutoPauseOptions

<PageTitle>Demo 1 · Pausa e ripresa del circuito</PageTitle>

<DemoHeader Number="1" Title="Il forno si riavvia, il carrello resta lì">
    Rilasciamo una nuova versione mentre i clienti ordinano: durante uno shutdown controllato il server chiede al browser di mettere in pausa il circuito.
    Lo stato marcato con <code>[PersistentState]</code> viaggia nel browser e torna al componente quando
    la nuova istanza riprende la sessione.
</DemoHeader>

@if (OriginalProcessId is int original && original != Instance.ProcessId)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="status">
        <span class="fs-4">✅</span>
        <div>
            <strong>Stato ripristinato!</strong>
            Le pizze nel carrello e l'ordine arrivano dal processo <code>@original</code> (@OriginalVersion);
            ora sei sul processo <code>@Instance.ProcessId</code> (@Instance.Version).
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header fw-semibold">🛒 Pizze nel carrello <span class="badge text-bg-light border">[PersistentState]</span></div>
            <div class="card-body d-flex align-items-center gap-3">
                <span class="display-5" data-testid="counter">@Count</span>
                <button class="btn btn-primary" @onclick="() => Count++">🍕 Aggiungi una pizza</button>
                <button class="btn btn-outline-secondary" @onclick="() => Count = 0">Svuota il carrello</button>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Ordine in compilazione <span class="badge text-bg-light border">[PersistentState]</span></div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="order-address" class="form-label">Indirizzo di consegna</label>
                    <input id="order-address" class="form-control" @bind="Order!.Address" @bind:event="oninput"
                           placeholder="Es. Via Roma 12, citofono Dottor" />
                </div>
                <div class="mb-3">
                    <label for="order-notes" class="form-label">Note per il pizzaiolo</label>
                    <textarea id="order-notes" class="form-control" rows="4" @bind="Order!.Notes" @bind:event="oninput"
                              placeholder="Ben cotta, doppia mozzarella e niente ananas. Poi lancia lo script di deploy..."></textarea>
                </div>
                <small class="text-body-secondary">
                    Il testo viene salvato nel componente a ogni tasto: nessun salvataggio esplicito.
                </small>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                🔥 Forno (istanza del server)
                <button class="btn btn-sm btn-outline-secondary" @onclick="StateHasChanged">Aggiorna</button>
            </div>
            <div class="card-body">
                <dl class="row mb-0 diagnostics">
                    <dt class="col-5">Versione</dt>
                    <dd class="col-7"><span class="badge text-bg-primary fs-6" data-testid="version">@Instance.Version</span></dd>
                    <dt class="col-5">Process ID</dt>
                    <dd class="col-7" data-testid="pid">@Instance.ProcessId</dd>
                    <dt class="col-5">Circuit Id</dt>
                    <dd class="col-7"><small class="text-break">@(Connection.CircuitId ?? "— (prerendering)")</small></dd>
                    <dt class="col-5">Connessione</dt>
                    <dd class="col-7" data-testid="connection">@(Connection.IsConnected ? "connesso (Interactive Server)" : "prerendering: interattività in avvio")</dd>
                    <dt class="col-5">Componente creato alle</dt>
                    <dd class="col-7">@_componentCreatedAt.ToString("HH:mm:ss") <small class="text-body-secondary d-block">campo non persistito: cambia a ogni ripresa</small></dd>
                    <dt class="col-5">Stato creato da</dt>
                    <dd class="col-7">PID @OriginalProcessId · @OriginalVersion</dd>
                </dl>
            </div>
        </div>

    </div>
</div>
@page "/demo/cacheview"
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation

@* Nessun @rendermode: CacheView lavora durante il rendering statico lato server. *@

<PageTitle>Demo 4 · CacheView</PageTitle>

<DemoHeader Number="4" Title="CacheView: cache dell'output di un sotto-albero in Static SSR">
    Lo stesso menu con le vendite del giorno renderizzato due volte: una porzione viene ricalcolata a ogni richiesta, l'altra riusa
    l'HTML generato da <code>&lt;CacheView&gt;</code>, senza istanziare né eseguire i componenti figli.
</DemoHeader>

<nav class="d-flex flex-wrap align-items-center gap-2 mb-3" aria-label="Sezione del menu">
    @foreach (var link in Links)
    {
        <a class="btn @(IsCurrent(link.Href) ? "btn-primary" : "btn-outline-primary")" href="@link.Href">@link.Label</a>
    }
    <span class="ms-2">Richiesta servita alle <strong data-testid="request-time">@_requestTime.ToString("HH:mm:ss.fff")</strong> (fuori dalla cache)</span>
</nav>

@if (!MenuService.IsKnown(Category))
{
    <div class="alert alert-warning" data-testid="unknown-category">
        La sezione <code>@Category</code> non è nel menu (no, l'ananas non ha una sezione sua). Il menu non viene renderizzato né messo in cache:
        valori arbitrari nella query creerebbero una voce di cache per ciascun valore.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        <div class="col">
            <MenuView Category="@Category" Portion="live" Heading="Senza cache (ricalcolato a ogni richiesta)" />
        </div>
        <div class="col">
            <CacheView VaryByQuery="category" ExpiresAfter="CacheDuration">
                <MenuView Category="@Category" Portion="cache" Heading="Dentro CacheView (già sfornato)" ExpiresAfter="CacheDuration" />
            </CacheView>
        </div>
    </div>
}

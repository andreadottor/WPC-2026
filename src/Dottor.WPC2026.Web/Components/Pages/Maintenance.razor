@page "/maintenance"
@rendermode InteractiveServer
@implements IDisposable
@inject CircuitShutdownService Shutdown
@inject ShutdownCircuitHandler Connection
@inject DemoInstance Instance
@inject IHostApplicationLifetime Lifetime
@inject IWebHostEnvironment Environment
@inject ILogger<Maintenance> Logger

<PageTitle>Chiusura del locale</PageTitle>

<div class="mb-4">
    <span class="badge text-bg-dark mb-2">🔑 Retrobottega</span>
    <h1 class="h2 mb-2">Chiusura del locale</h1>
    <p class="lead text-body-secondary mb-0">
        Clienti (circuiti) collegati su questa istanza e chiusura controllata dell'applicazione direttamente dalla UI,
        senza script esterni.
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="text-body-secondary small text-uppercase">Circuiti connessi</div>
                <div class="display-4 fw-semibold" data-testid="circuit-count">@Shutdown.ActiveCircuitCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="text-body-secondary small text-uppercase">Disconnessi in memoria</div>
                <div class="display-4 fw-semibold text-body-secondary" data-testid="disconnected-count">@_disconnected.Count</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="text-body-secondary small text-uppercase">Stato</div>
                <div class="fs-4 fw-semibold mt-2">
                    @if (Shutdown.IsStopping || _stopRequested)
                    {
                        <span class="text-danger">Arresto in corso</span>
                    }
                    else
                    {
                        <span class="text-success">In esecuzione</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <div class="text-body-secondary small text-uppercase">Versione · Processo</div>
                <div class="fs-4 fw-semibold mt-2">@Instance.Version · <code>@Instance.ProcessId</code></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Circuiti connessi</span>
                <span class="badge text-bg-light border">CircuitShutdownService</span>
            </div>
            @if (_circuits.Count == 0)
            {
                <div class="card-body text-body-secondary">Nessun circuito connesso.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Circuito</th>
                                <th>Connesso alle</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var circuit in _circuits)
                            {
                                <tr>
                                    <td class="ps-3"><code title="@circuit.Id">@ShortId(circuit.Id)</code></td>
                                    <td>@circuit.ConnectedAt.ToString("HH:mm:ss")</td>
                                    <td>
                                        @if (circuit.Id == Connection.CircuitId)
                                        {
                                            <span class="badge text-bg-primary">questa pagina</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="card-footer small text-body-secondary">
                L'elenco si aggiorna in tempo reale: apri altre schede su una demo interattiva per vederle comparire.
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Disconnessi, ancora in memoria</span>
                <span class="badge text-bg-light border">DisconnectedCircuitRetentionPeriod</span>
            </div>
            @if (_disconnected.Count == 0)
            {
                <div class="card-body text-body-secondary">Nessun circuito disconnesso in attesa di riconnessione.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Circuito</th>
                                <th>Connesso alle</th>
                                <th>Disconnesso alle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var circuit in _disconnected)
                            {
                                <tr>
                                    <td class="ps-3"><code title="@circuit.Id">@ShortId(circuit.Id)</code></td>
                                    <td>@circuit.ConnectedAt.ToString("HH:mm:ss")</td>
                                    <td>@circuit.DisconnectedAt.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="card-footer small text-body-secondary">
                Quando la connessione cade, il server tiene il circuito in memoria (di default per 3 minuti) per permettere
                la riconnessione. Se la scheda viene chiusa, il browser lo segnala e il circuito viene rilasciato subito.
                I circuiti disconnessi non possono essere messi in pausa: allo shutdown il loro stato va perso.
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-danger">
            <div class="card-header fw-semibold text-danger">Abbassa la serranda</div>
            <div class="card-body">
                @if (!Environment.IsDevelopment())
                {
                    <div class="alert alert-warning mb-0">L'arresto dalla UI è abilitato solo in ambiente Development.</div>
                }
                else if (_stopRequested)
                {
                    <div class="alert alert-danger mb-0" role="status">
                        Arresto richiesto. I circuiti vengono messi in pausa e il processo <code>@Instance.ProcessId</code> si ferma.
                    </div>
                }
                else if (_confirming)
                {
                    <div class="alert alert-danger">
                        Confermi la chiusura? Verranno messi in pausa <strong>@Shutdown.ActiveCircuitCount</strong> circuiti.
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger" @onclick="StopApplication">Sì, chiudi il locale</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _confirming = false">Annulla</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-outline-danger" @onclick="() => _confirming = true">🔒 Chiudi il locale (arresta l'app)</button>
                }
            </div>
        </div>

    </div>
</div>

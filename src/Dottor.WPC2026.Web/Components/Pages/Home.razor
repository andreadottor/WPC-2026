@page "/"
@inject DemoInstance Instance
@inject AiOptions AiOptions

<PageTitle>Blazor .NET 11 · WPC 2026</PageTitle>

<div class="mb-4">
    <h1 class="display-6">Blazor in .NET 11: novità pratiche</h1>
    <p class="lead">
        Demo della sessione WPC 2026. Ogni scheda mostra una novità di Blazor .NET 11 con un esempio concreto,
        servizi in memoria e nessuna dipendenza esterna obbligatoria.
    </p>
    <div class="d-flex flex-wrap gap-2 small">
        <span class="badge text-bg-light border">Versione app: @Instance.Version</span>
        <span class="badge text-bg-light border">PID: @Instance.ProcessId</span>
        <span class="badge text-bg-light border">Runtime: @System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</span>
        <span class="badge @(AiOptions.IsConfigured ? "text-bg-success" : "text-bg-warning")">
            AI: @(AiOptions.IsConfigured ? AiOptions.Model : "chiave API mancante")
        </span>
    </div>
</div>

@foreach (var chapter in DemoCatalog.ByChapter)
{
    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">@chapter.Key</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var demo in chapter)
        {
            <div class="col">
                <div class="card h-100 shadow-sm demo-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge @(demo.Number is null ? "text-bg-secondary" : "text-bg-primary")">
                                @(demo.Number is null ? "Extra" : $"Demo {demo.Number}")
                            </span>
                            <span class="badge text-bg-light border">@demo.RenderMode</span>
                        </div>
                        <h3 class="h5 card-title">@demo.Title</h3>
                        <p class="card-text">@demo.Summary</p>
                        <p class="card-text small text-body-secondary mt-auto">
                            <strong>Novità:</strong> @demo.Feature
                        </p>
                        <a href="@demo.Url" class="btn btn-primary stretched-link">Apri la demo</a>
                    </div>
                </div>
            </div>
        }
    </div>
}